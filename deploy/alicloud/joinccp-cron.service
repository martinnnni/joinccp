[Unit]
Description=CAUC Party Development Assistant daily reminders
After=joinccp.service

[Service]
Type=oneshot
User=joinccp
Group=joinccp
WorkingDirectory=/opt/joinccp/current
EnvironmentFile=/etc/joinccp/environment
ExecStart=/usr/bin/node server/cron.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/joinccp
UMask=0077
