[Unit]
Description=CAUC Party Development Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joinccp
Group=joinccp
WorkingDirectory=/opt/joinccp/current
EnvironmentFile=/etc/joinccp/environment
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/joinccp
UMask=0077

[Install]
WantedBy=multi-user.target
